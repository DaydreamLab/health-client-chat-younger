# Candor Core public API (browser → core; CORS must allow this origin).
NUXT_PUBLIC_API_BASE=http://localhost:8080/api/v1

# Support inbox shown in footers / about (build-time). Leave empty to hide the line.
# Beta (github-pages workflow) sets candor-ai@daydream-lab.com; prod omits.
# NUXT_PUBLIC_SUPPORT_EMAIL=

# Agent v2 UI (`/chat/v2`). Default off. Set to 1 to enable; otherwise the route 404s.
# NUXT_PUBLIC_AGENT_V2_ENABLED=0

# Optional Agent v2 SSE (POST …/messages/stream). Default off; falls back to sync.
# NUXT_PUBLIC_AGENT_V2_STREAMING=0
